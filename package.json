{
  "name": "Hospital_PM",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.13.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-requester-portal": "cds watch --open requesterportal/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approval-port": "cds watch --open approvalport/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-approval-portal": "cds watch --open approvalportal/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-receipt-portal": "cds watch --open receiptportal/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/requester-portal",
    "app/approval-portal",
    "app/receipt-portal"
  ],
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked"
      }
    }
  }
}
